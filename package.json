{
  "name": "kmo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc",
    "lint:md": "markdownlint \"**/*.md\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "markdownlint-cli": {
      "js-yaml": "5.4.3"
    },
    "kubernetes-fluent-client": {
      "@kubernetes/client-node": {
        "js-yaml": "4.3.2"
      },
      "js-yaml": "5.4.3",
      "undici": "8.10.2"
    },
    "katex": "0.19.0",
    "smol-toml": "1.9.1"
  }
}
